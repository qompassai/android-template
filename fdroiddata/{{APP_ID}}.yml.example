# Pick ONE precise category from F-Droid's list (e.g. Puzzle Game, Navigation).
# Never invent one.
Categories:
  - TODO_CATEGORY

License: Apache-2.0

AuthorName: Qompass AI
AuthorEmail: TODO_AUTHOR_EMAIL

WebSite: https://github.com/qompassai/{{SLUG}}
SourceCode: https://github.com/qompassai/{{SLUG}}
IssueTracker: https://github.com/qompassai/{{SLUG}}/issues
Changelog: https://github.com/qompassai/{{SLUG}}/releases

AutoName: {{APP_NAME}}
# Description is intentionally absent: the fastlane tree provides it.
# Never set Name/Summary/Description when fastlane metadata exists.

# Declare honestly. Examples: Tracking, NonFreeNet, NonFreeAssets.
# Delete the block if the app truly has none.
AntiFeatures:
  TODO_ANTIFEATURES

RepoType: git
Repo: https://github.com/qompassai/{{SLUG}}.git

Builds:
